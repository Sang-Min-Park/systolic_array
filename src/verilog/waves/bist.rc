Revision 1.0

; Signal groups for RTL debugging.
openDirFile -d / "." "bist.fsdb"
signalSpacing 3
top 0

addGroup "Control"
activeDirFile "." "bist.fsdb"
addSignal -h 15 /tb_external_bist/clk_i
addSignal -h 15 /tb_external_bist/rstn_async_i
addSignal -h 15 /tb_external_bist/ext_en_i
addSignal -h 15 -UNSIGNED /tb_external_bist/tests[31:0]
addSignal -h 15 -UNSIGNED /tb_external_bist/inputs_seen[31:0]
addSignal -h 15 -UNSIGNED /tb_external_bist/outputs_seen[31:0]

