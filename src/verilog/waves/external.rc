addSignal -h 15 /tb_external_bist/dut/ext_input_w[2][7:0]
addSignal -h 15 /tb_external_bist/dut/ext_input_w[3][7:0]

addGroup "PE00"
activeDirFile "." "external.fsdb"
addSignal -h 15 /tb_external_bist/dut/matrix_mult_0/gen_row[0]/gen_col[0]/u_pe/act_i[7:0]
