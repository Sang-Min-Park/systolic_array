; Memory readback and functional-clock pause debugging.
openDirFile -d / "." "memory_readback.fsdb"
signalSpacing 3
top 0

addGroup "Control"
activeDirFile "." "memory_readback.fsdb"
addSignal -h 15 /tb_memory_readback/clk_i
addSignal -h 15 /tb_memory_readback/rstn_async_i
addSignal -h 15 /tb_memory_readback/en_i
